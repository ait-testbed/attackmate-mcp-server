API_BASE_URL=https://localhost:8445
API_USERNAME=youruser
API_PASSWORD=yourpassword
# Set to path of attackmate/docs/source to enable documentation resources
ATTACKMATE_DOCS_PATH=/path/to/attackmate/docs/source
# Set to true or path to CA bundle to verify SSL; false for self-signed certs
SSL_VERIFY=true
# Seconds to wait for a single execute_command call (0 = no timeout)
COMMAND_TIMEOUT=300
# Seconds to wait for a run_playbook call (0 = no timeout)
PLAYBOOK_TIMEOUT=1800
# Transport: stdio (default) or sse
MCP_TRANSPORT=stdio
# SSE-only settings (ignored for stdio)
MCP_HOST=127.0.0.1
MCP_PORT=8000
